#!/usr/bin/env nix-shell
#!nix-shell ../shell.nix -i bash
set -euo pipefail

die() {
  echo "bin/run: $*" >&2
  exit 1
}
(($# >= 2)) || die "usage: bin/run <test> <model> [--harness H] [--effort E] [--login FILE]"

test=$1
model=$2
shift 2
case $model in
  claude-*) harness=claude-code ;;
  gpt-*) harness=codex ;;
  stub) harness=stub ;;
  *) harness= ;;
esac
effort=medium
login=
while (($#)); do
  case $1 in
    --harness) harness=$2 ;;
    --effort) effort=$2 ;;
    --login) login=$(realpath "$2") ;;
    *) die "unknown option: $1" ;;
  esac
  shift 2
done

root=$(cd "$(dirname "$0")/.." && pwd -P)
prompt=$root/tests/$test/PROMPT.md
[ -f "$prompt" ] || die "no such test: $test"
case $harness in
  claude-code) argv=(claude -p --output-format stream-json --verbose --model "${model}[1m]" --effort "$effort" --dangerously-skip-permissions) ;;
  codex) argv=(codex exec --json --model "$model" -c "model_reasoning_effort=$effort" --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check -) ;;
  stub) argv=(stub) ;;
  "") die "no default harness for $model; pass --harness" ;;
  *) die "unknown harness: $harness" ;;
esac
case $model:$harness in
  stub:stub) ;;
  stub:* | *:stub) die "the stub model runs only with the stub harness" ;;
  *) [ -f "$login" ] || die "$harness needs --login FILE" ;;
esac
case $login in "$root"/*) die "keep the login outside the repository" ;; esac
case $root$test$harness$model$effort$login in *[[:space:],]*) die "no whitespace or commas in paths, model or effort" ;; esac
[ -w /dev/kvm ] || die "needs read-write /dev/kvm"

vm=$(nix-build --no-out-link "$root/vm" -A vm)
version=$(nix-instantiate --eval --json "$root/vm" -A "version.$harness")
run=$root/runs/$test/$model/$(date -u +%Y-%m-%dT%H%M%SZ)
tmp=$(mktemp -d -p /var/tmp)
trap 'rm -rf "$tmp"' EXIT
out=$tmp/out
mkdir "$out"
printf '%s\0' "${argv[@]}" >"$tmp/argv"

cred() { printf ' -fw_cfg name=opt/io.systemd.credentials/%s,%s' "$1" "$2"; }
port() { printf ' -chardev file,id=%s,path=%s -device virtserialport,chardev=%s,name=%s' "$1" "$2" "$1" "$1"; }
boot() {
  QEMU_OPTS="-no-reboot -device virtio-serial-pci$1" NIX_DISK_IMAGE=$tmp/disk.qcow2 TMPDIR=$tmp "$vm/bin/run-nixos-vm" </dev/null >>"$out/console.log" 2>&1 || :
  rm -f "$tmp/disk.qcow2"
}
fail() {
  tail -n 40 "$out/console.log" | cat -v >&2
  die "$@"
}
echo "bin/run: console at $out/console.log" >&2

started=$(date -u +%FT%TZ)
boot "$(cred argv "file=$tmp/argv")$(cred prompt "file=$prompt")${login:+$(cred login "file=$login")}$(port transcript "$out/transcript.jsonl")$(port tree "$out/tree.tar.zst")"
finished=$(date -u +%FT%TZ)
[ -s "$out/tree.tar.zst" ] || fail "the guest did not finish the agent's turn"
zstd -dc "$out/tree.tar.zst" >"$tmp/tree.tar"

boot " -drive file=$tmp/tree.tar,format=raw,if=none,id=tree,readonly=on -device virtio-blk-pci,drive=tree,serial=tree$(port check "$out/check.log")$(port status "$tmp/status.json")"
[ -s "$tmp/status.json" ] || fail "the check VM did not report"

if [ -n "$login" ]; then
  { jq -r '.. | strings' "$login" 2>/dev/null || cat "$login"; } | awk 'length >= 20' >"$tmp/login"
  scan=0
  grep -lFf "$tmp/login" "$out"/* "$tmp/tree.tar" >&2 || scan=$?
  [ "$scan" = 1 ] || die "the login appears in the files above, or the scan failed; the run is discarded"
fi

jq -n \
  --arg test "$test" \
  --arg model "$model" \
  --arg harness "$harness" \
  --argjson version "$version" \
  --arg effort "$effort" \
  --arg setup "$({ echo "$vm"; cat "$prompt"; } | sha256sum | cut -d ' ' -f 1)" \
  --arg started "$started" \
  --arg finished "$finished" \
  --slurpfile check "$tmp/status.json" \
  '{
    test: $test,
    model: $model,
    harness: {name: $harness, version: $version, argv: $ARGS.positional},
    effort: $effort,
    setup: $setup,
    started: $started,
    finished: $finished,
    check: $check[0],
    tree: "tree.tar.zst"
  }' --args -- "${argv[@]}" >"$out/run.json"

mkdir -p "$(dirname "$run")"
mv -T "$out" "$run"
"$root/bin/metrics" "$run"
