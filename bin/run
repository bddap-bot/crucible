#!/usr/bin/env nix-shell
#!nix-shell ../shell.nix -i bash
set -euo pipefail

die() {
  echo "bin/run: $*" >&2
  exit 1
}
(($# >= 2)) || die "usage: bin/run <test> <model> [--harness H] [--effort E] [--login FILE]"

test=$1
model=$2
shift 2
case $model in
  claude-*) harness=claude-code ;;
  stub) harness=stub ;;
  *) harness= ;;
esac
effort=medium
login=
while (($#)); do
  case $1 in
    --harness) harness=$2 ;;
    --effort) effort=$2 ;;
    --login) login=$(realpath "$2") ;;
    *) die "unknown option: $1" ;;
  esac
  shift 2
done

root=$(cd "$(dirname "$0")/.." && pwd -P)
prompt=$root/tests/$test/PROMPT.md
[ -f "$prompt" ] || die "no such test: $test"
case $harness in
  claude-code) argv=(claude -p --output-format stream-json --verbose --model "${model}[1m]" --effort "$effort" --dangerously-skip-permissions) ;;
  stub) argv=(stub) ;;
  "") die "no default harness for $model; pass --harness" ;;
  *) die "unknown harness: $harness" ;;
esac
case $model:$harness in
  stub:stub) ;;
  stub:* | *:stub) die "the stub model runs only with the stub harness" ;;
  *) [ -f "$login" ] || die "$harness needs --login FILE" ;;
esac
case $login in "$root"/*) die "keep the login outside the repository" ;; esac
case $root$test$harness$model$effort in *[[:space:],]*) die "no whitespace or commas in paths, model or effort" ;; esac
[ -w /dev/kvm ] || die "needs read-write /dev/kvm"

vm=$(nix-build --no-out-link "$root/vm" -A vm)
version=$(nix-instantiate --eval --json "$root/vm" -A "version.$harness")
run=$root/runs/$test/$model/$(date -u +%Y-%m-%dT%H%M%SZ)
tmp=$(mktemp -d -p /var/tmp)
trap 'rm -rf "$tmp"' EXIT
out=$tmp/out
mkdir "$out"
printf '%s\0' "${argv[@]}" >"$tmp/argv"

cred() { printf ' -fw_cfg name=opt/io.systemd.credentials/%s,%s' "$1" "$2"; }
limit=$((4 << 20))
capped() { (trap '' XFSZ && ulimit -f "$limit" && exec "$@"); }
sink() { capped cat >>"$1" || { cat >/dev/null; false; }; }
fail() {
  tail -c 64K "$out/console.log" | tail -n 40 | cat -v >&2
  die "$@"
}
boot() {
  local opts=$1 port name readers=() reader over=
  shift
  for port; do
    name=${port%%=*}
    mkfifo "$tmp/$name.port"
    sink "${port#*=}" <"$tmp/$name.port" &
    readers+=($!)
    opts+=" -chardev file,id=$name,path=$tmp/$name.port -device virtserialport,chardev=$name,name=$name"
  done
  {
    QEMU_OPTS="-no-reboot -device virtio-serial-pci$opts" NIX_DISK_IMAGE=$tmp/disk.qcow2 TMPDIR=$tmp timeout --foreground 12h "$vm/bin/run-nixos-vm" </dev/null 2>&1 || :
  } | sink "$out/console.log" || over=1
  rm -f "$tmp/disk.qcow2"
  for port; do
    : <>"$tmp/${port%%=*}.port"
  done
  for reader in "${readers[@]}"; do
    wait "$reader" || over=1
  done
  rm -f "$tmp"/*.port
  [ -z "$over" ] || fail "the guest wrote more than $((limit >> 20)) GiB to one output; the run is discarded"
}
echo "bin/run: console at $out/console.log" >&2

started=$(date -u +%FT%TZ)
CRUCIBLE_LOGIN_FILE=$login boot "$(cred argv "file=$tmp/argv")$(cred prompt "file=$prompt")" "transcript=$out/transcript.jsonl" "tree=$out/tree.tar.zst"
finished=$(date -u +%FT%TZ)
[ -s "$out/tree.tar.zst" ] || fail "the guest did not finish the agent's turn"
capped zstd -qdc "$out/tree.tar.zst" >"$tmp/tree.tar" || die "the tree does not unpack within $((limit >> 20)) GiB; the run is discarded"

CRUCIBLE_LOGIN_FILE='' boot " -drive file=$tmp/tree.tar,format=raw,if=none,id=tree,readonly=on -device virtio-blk-pci,drive=tree,serial=tree" "check=$out/check.log" "status=$tmp/status.json"
[ -s "$tmp/status.json" ] || fail "the check VM did not report"

jq -n \
  --arg test "$test" \
  --arg model "$model" \
  --arg harness "$harness" \
  --argjson version "$version" \
  --arg effort "$effort" \
  --arg setup "$({ echo "$vm"; cat "$prompt"; } | sha256sum | cut -d ' ' -f 1)" \
  --arg started "$started" \
  --arg finished "$finished" \
  --slurpfile check "$tmp/status.json" \
  '{
    test: $test,
    model: $model,
    harness: {name: $harness, version: $version, argv: $ARGS.positional},
    effort: $effort,
    setup: $setup,
    started: $started,
    finished: $finished,
    check: $check[0],
    tree: "tree.tar.zst"
  }' --args -- "${argv[@]}" >"$out/run.json"

mkdir -p "$(dirname "$run")"
mv -T "$out" "$run"
capped "$root/bin/metrics" "$run"
